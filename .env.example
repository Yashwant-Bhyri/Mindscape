# MindScape API Keys
# Rename this file to .env and fill in your keys

# Preferred: OpenRouter + current DeepSeek model (LLM inference)
OPENROUTER_API_KEY="your-openrouter-key"
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash

# Optional alternatives
# OPENAI_MODEL=deepseek/deepseek-v4-pro
# DEEPSEEK_API_KEY="your-deepseek-key"
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash

# Google Gemini (primary LLM fallback + primary STT via audio understanding)
GEMINI_API_KEY="your-gemini-key"
# GEMINI_MODEL=gemini-2.0-flash

# Optional: direct OpenAI key for Whisper STT
# Needed only if OPENAI_API_KEY points to a proxy that does not support /audio/transcriptions
WHISPER_API_KEY="your-openai-key"

# Deepgram voice-agent layer for Nancy
DEEPGRAM_API_KEY="your-deepgram-key"
# Optional dedicated model override for Nancy's think provider
# NANCY_OPENAI_MODEL=gpt-4o-mini
